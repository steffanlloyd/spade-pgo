<launch>
  <!-- Toggle visualizations independently -->
  <arg name="rviz_fastlio" default="false"/>
  <arg name="rviz_pgo"     default="true"/>

  <!-- ========== FAST-LIO (mapping) ========== -->
  <!-- Load FAST-LIO params into the node's private namespace -->
  <rosparam command="load"
            file="$(find spade)/config/fastlio_mid360.yaml"
            ns="laserMapping"/>
  <rosparam command="load" file="$(find fast_lio)/config/mid360.yaml" />

  <!-- FAST-LIO mapping node -->
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />

  <!-- Optional RViz for FAST-LIO -->
  <group if="$(arg rviz_fastlio)">
    <node launch-prefix="nice"
          pkg="rviz" type="rviz" name="rviz_fastlio"
          args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz"/>
  </group>

  <!-- ========== PGO (Scan Context + ICP + Pose Graph) ========== -->
  <!-- Load PGO params into the node's private namespace -->
  <rosparam command="load"
            file="$(find spade)/config/pgo.yaml" />

  <!-- PGO node -->
  <node pkg="spade_pgo" type="spade_pgo_node" name="spade_pgo_node" output="screen">
    <!-- Keep the original remap so ScanContext sees the map-registered cloud -->
    <remap from="/cloud_for_scancontext" to="/cloud_registered"/>
  </node>

  <!-- Optional RViz for PGO -->
  <group if="$(arg rviz_pgo)">
    <node launch-prefix="nice"
          pkg="rviz" type="rviz" name="rviz_pgo"
          args="-d $(find spade)/rviz_cfg/spade.rviz"/>
  </group>

  <!-- ========== Terrain Altitude Correction (unchanged) ========== -->
  <rosparam command="load"
            file="$(find spade)/config/terrain_correction.yaml"
            ns="terrain_altitude_correction_node"/>
  <node pkg="spade"
        type="terrain_altitude_correction.py"
        name="terrain_altitude_correction_node"
        output="screen"/>
</launch>
