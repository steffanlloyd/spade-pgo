<launch>

    <param name="scan_line" type="int" value="4" />

    <!-- if 1, do mapping 10 Hz, if 2, do mapping 5 Hz. Suggest to use 1, it will adjust frequence automaticlly -->
    <param name="mapping_skip_frame" type="int" value="1" />

    <!-- remove too closed points -->
    <param name="minimum_range" type="double" value="0.1"/>

    <param name="mapping_line_resolution" type="double" value="0.4"/>        <!-- A-LOAM -->
    <param name="mapping_plane_resolution" type="double" value="0.8"/>       <!-- A-LOAM -->

    <param name="mapviz_filter_size" type="double" value="0.1"/> 

    <!-- SC-A-LOAM -->   
    <param name="keyframe_meter_gap" type="double" value="1.0"/>

    <!-- Scan Context -->
    <param name="sc_dist_thres" type="double" value="0.3"/>                  <!-- SC-A-LOAM, if want no outliers, use 0.1-0.15 -->
    <!-- <param name="sc_max_radius" type="double" value="40.0"/> 20 or 40 for indoor -->
    <param name="sc_max_radius" type="double" value="80.0"/>                 <!-- for outdoor -->
    <param name="sc_leaf_size_down" type="double" value="0.4"/>              <!-- for downsampling -->

    <param name="lidar_type" type="string" value="MID360"/>

    <!-- GPS Parameters -->
    <param name="gps_topic" type="string" value="/mavros/global_position/local"/>
    <param name="use_gps" type="bool" value="false"/>                 
    <param name="use_gps_elevation" type="bool" value="false"/>   
    <param name="gps_dist_thr" type="double" value="5.0"/>                  <!-- Distance between gps measurements to be implemented in the graph-->
    <param name="gps_cov_thr" type="double" value="4.0"/>                   <!-- Covariance threshold for gps measurement to be taken into account (before applying scaling factor)-->
    <param name="gps_scale" type="double" value="1.0"/>                     <!-- Scaling factor to be multiplied with gps Covariance -->

    <!-- ICP Parameters (registration when closing loop)-->
    <param name="icp_num_keyframes_old" type="double" value="10"/>           <!-- Number of keyframes to be kept for the submap of the old keyframe of the loop -->
    <param name="icp_num_keyframes_curr" type="double" value="1"/>           <!-- Number of keyframes to be kept for the submap of the current keyframe of the loop (a small integer is suggested) -->
    <param name="icp_loop_fitness_score_thr" type="double" value="0.5"/>     <!-- ICP fitness score to accept a loop closure -->
    <param name="icp_leaf_size_down" type="double" value="0.2"/>             <!-- Downsampling parameters for icp point clouds -->


    <!-- input from FASTLIO2 -->
    <remap from="/aft_mapped_to_init" to="/lidar_odom_2"/>
    <remap from="/velodyne_cloud_registered_local" to="/cloud_registered_body"/>
    <remap from="/cloud_for_scancontext" to="/cloud_registered_2"/>          <!-- because ScanContext requires lidar-ego-centric coordinate for the better performance -->

    <!-- utils -->
    <param name="save_directory" type="string" value="/home/john/SLAM_Spade/src/FAST_LIO_SLAM/SC-PGO/Data/"/>  <!-- CHANGE THIS and end with / -->

    <!-- nodes -->
    <node pkg="aloam_velodyne" type="alaserPGO" name="alaserPGO" output="screen" /> <!-- Scan Context-based PGO -->

    <!-- visulaization -->
    <arg name="rvizscpgo" default="true" />
    <group if="$(arg rvizscpgo)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rvizscpgo" args="-d $(find aloam_velodyne)/rviz_cfg/aloam_velodyne.rviz" />
    </group>

</launch>
